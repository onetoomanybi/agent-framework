# Configuration Example for Microsoft Fabric + Azure AI Foundry Integration
# ===========================================================================
# Copy this file to .env or set these as environment variables

# ===========================================================================
# FABRIC NOTEBOOK CONFIGURATION
# ===========================================================================

# Azure AI Foundry Endpoint
# Find this in your AI Foundry project's overview page
AI_FOUNDRY_ENDPOINT=https://your-project-name.services.ai.azure.com

# Agent ID
# Find this in your AI Foundry agent's details page
AGENT_ID=asst_YourAgentIDHere

# ===========================================================================
# LAKEHOUSE CONFIGURATION
# ===========================================================================

# Workspace ID (GUID)
# Find this in Fabric workspace settings
FABRIC_WORKSPACE_ID=12345678-1234-1234-1234-123456789012

# Lakehouse ID (GUID)
# Find this in the lakehouse properties
FABRIC_LAKEHOUSE_ID=87654321-4321-4321-4321-210987654321

# Default path for file operations
DEFAULT_LAKEHOUSE_PATH=Files

# ===========================================================================
# AZURE FUNCTION APP CONFIGURATION (for agent tools)
# ===========================================================================

# Function App URL
# This is where your agent tools are hosted
FUNCTION_APP_URL=https://your-function-app.azurewebsites.net/api

# Function App Key (if using function-level auth)
# Find this in Function App -> Functions -> Function Keys
FUNCTION_APP_KEY=your_function_key_here

# ===========================================================================
# AUTHENTICATION CONFIGURATION
# ===========================================================================

# Azure Tenant ID
# Find this in Azure AD -> Properties
AZURE_TENANT_ID=your-tenant-id-here

# Client ID (if using service principal instead of managed identity)
AZURE_CLIENT_ID=your-client-id-here

# Client Secret (if using service principal)
AZURE_CLIENT_SECRET=your-client-secret-here

# ===========================================================================
# OPTIONAL SETTINGS
# ===========================================================================

# Logging level
LOG_LEVEL=INFO

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Maximum file size to read (bytes)
MAX_FILE_SIZE=104857600  # 100MB

# Maximum rows to return from CSV
MAX_CSV_ROWS=1000

# ===========================================================================
# NOTES
# ===========================================================================

# For Fabric Notebooks:
# - Use notebookutils.credentials for authentication (no keys needed)
# - Scope: https://ml.azure.com

# For Azure Functions (agent tools):
# - Enable Managed Identity in Function App
# - Grant permissions in Fabric workspace
# - Scope: https://analysis.windows.net/powerbi/api/.default

# Security Best Practices:
# - Never commit this file with actual values to source control
# - Use Azure Key Vault for production secrets
# - Enable managed identity wherever possible
# - Follow principle of least privilege
